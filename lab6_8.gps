        SIMULATE
CVM     EQU 5,F
SAT     FUNCTION P1,E4
1,5/2,6/3,4/4,7
CENT    FUNCTION P1,E4
1,FN$RD1/2,FN$RD2/3,FN$RD3/4,2
RD1     FUNCTION RN1,D3
.2,1/.4,3/1,4
RD2     FUNCTION RN1,D3
.1,3/.5,5/1,4
RD3     FUNCTION RN1,D2
.5,5/1,3
        INITIAL X1,0
        INITIAL X2,0
        INITIAL X3,0
        INITIAL X4,0
        INITIAL X5,0
        INITIAL X6,0
        INITIAL X7,0
        INITIAL X8,0

        GENERATE ,,,1
        SPLIT 3,INIT,1
INIT    TEST E P1,4,LOCAL
        PRIORITY 10
LOCAL   SEIZE P1
        ADVANCE FN$SAT
        RELEASE P1
        SAVEVALUE 5+,1
        QUEUE WAITC
        SAVEVALUE 6+,1
        TEST E P1,4,LOW
        TEST E F$CVM,0,INTR
        TRANSFER ,HIGH
INTR    SAVEVALUE 7+,1
HIGH    PREEMPT CVM,PR
        DEPART WAITC
        ADVANCE FN$CENT
        RETURN CVM
        TRANSFER ,DONE
LOW     SEIZE CVM
        DEPART WAITC
        ADVANCE FN$CENT
        RELEASE CVM
DONE    SAVEVALUE P1+,1
        SAVEVALUE 8+,1
        TRANSFER ,LOCAL

        GENERATE 1000
        TERMINATE 1
        START 1
        END
