        SIMULATE

1       FUNCTION RN1,D3
.2,1/.4,3/1,4

2       FUNCTION RN2,D3
.1,3/.5,5/1,4

4       FUNCTION RN4,D2
.2,2/1,4

5       FUNCTION P1,M4
1,FN1/2,FN2/3,5/4,FN4

        GENERATE ,,,4,15
        ASSIGN 1,1
        TRANSFER ,CPU1

        GENERATE 10,1,,,30
        ASSIGN 1,2
        TRANSFER ,CPU2

        GENERATE ,,,2,25
        ASSIGN 1,3
        TRANSFER ,CPU3

        GENERATE ,,,3,35
        SAVEVALUE NUM4+,1
        ASSIGN 1,4
        ASSIGN 2,X$NUM4
        TRANSFER ,CPU4

CPU1    QUEUE WAITCP1
        SEIZE CP1
        DEPART WAITCP1
        ADVANCE 5,3
        RELEASE CP1
        TRANSFER ,MEMORY

CPU2    QUEUE WAITCP2
        SEIZE CP2
        DEPART WAITCP2
        ADVANCE 6
        RELEASE CP2
        TRANSFER ,MEMORY

CPU3    QUEUE WAITCP3
        SEIZE CP3
        DEPART WAITCP3
        ADVANCE 4
        RELEASE CP3
        TRANSFER ,MEMORY

CPU4    QUEUE WAITCP4
        SEIZE CP4
        DEPART WAITCP4
        TEST E P2,1,C4B
        ADVANCE 7
        TRANSFER ,C4END
C4B     TEST E P2,2,C4C
        ADVANCE 2
        TRANSFER ,C4END
C4C     ADVANCE 8
C4END   RELEASE CP4
        TRANSFER ,MEMORY

MEMORY  QUEUE QMEM
        SEIZE MEM
        DEPART QMEM
        ADVANCE FN5
        RELEASE MEM
        TEST E P1,1,RET2
        TRANSFER ,CPU1
RET2    TEST E P1,2,RET3
        TRANSFER ,CPU2
RET3    TEST E P1,3,RET4
        TRANSFER ,CPU3
RET4    TRANSFER ,CPU4

        GENERATE 80
        TERMINATE 1
        START 1
        END
